<Window x:Class="StyledEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ink="clr-namespace:System.Windows.Ink;assembly=PresentationCore"
        xmlns:ctl="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="Графический редактор со стилями" Height="420" Width="660">
    <!-- Задание 2: внешний вид однотипных элементов задан стилями -->
    <Window.Resources>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="DarkBlue" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="DarkBlue" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="DarkBlue" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0" />
                        <GradientStop Color="LightSteelBlue" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <x:Array x:Key="Brushes" x:Type="{x:Type ink:DrawingAttributes}">
            <ink:DrawingAttributes Color="Black" Width="3" Height="3" />
            <ink:DrawingAttributes Color="Red" Width="8" Height="8" />
            <ink:DrawingAttributes Color="Green" Width="14" Height="14" />
            <ink:DrawingAttributes Color="Blue" Width="22" Height="22" />
        </x:Array>

        <x:Array x:Key="Modes" x:Type="{x:Type ctl:InkCanvasEditingMode}">
            <x:Static Member="ctl:InkCanvasEditingMode.Ink" />
            <x:Static Member="ctl:InkCanvasEditingMode.Select" />
            <x:Static Member="ctl:InkCanvasEditingMode.EraseByStroke" />
        </x:Array>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="Цвет и размер кисти" Style="{StaticResource CaptionStyle}" />
                <ListBox x:Name="BrushList" ItemsSource="{StaticResource Brushes}"
                         SelectedIndex="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Color}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Режим работы" Style="{StaticResource CaptionStyle}" />
                <ListBox x:Name="ModeList" ItemsSource="{StaticResource Modes}"
                         SelectedIndex="0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource PanelStyle}">
            <InkCanvas Background="White"
                       DefaultDrawingAttributes="{Binding ElementName=BrushList, Path=SelectedValue}"
                       EditingMode="{Binding ElementName=ModeList, Path=SelectedValue}" />
        </Border>
    </DockPanel>
</Window>
