<UserControl x:Class="ImageViewer.ImageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260" Height="240" RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
    </UserControl.RenderTransform>

    <!-- Задание 1: повторяющийся XAML-код вынесен в пользовательский элемент -->
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- внешний контейнер: тень -->
        <StackPanel x:Name="ShadowLayer">
            <StackPanel.Effect>
                <DropShadowEffect x:Name="Shadow" BlurRadius="18" ShadowDepth="6"
                                  Opacity="0" Color="Black" />
            </StackPanel.Effect>

            <!-- внутренний контейнер: размытие -->
            <Border x:Name="BlurLayer" BorderBrush="Gray" BorderThickness="1"
                    Background="White" Padding="4">
                <Border.Effect>
                    <BlurEffect x:Name="Blur" Radius="6" />
                </Border.Effect>
                <Image x:Name="Picture" Width="240" Height="170" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="Turn" Angle="0" />
                    </Image.RenderTransform>
                </Image>
            </Border>
        </StackPanel>

        <TextBlock x:Name="Caption" HorizontalAlignment="Center" Margin="0,6,0,4" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="LeftButton" Content="⟲" ToolTip="Повернуть влево" />
            <Button x:Name="RightButton" Content="⟳" ToolTip="Повернуть вправо" />
        </StackPanel>
    </StackPanel>

    <UserControl.Triggers>
        <!-- наведение: элемент увеличивается, размытие исчезает, появляется тень -->
        <EventTrigger RoutedEvent="UIElement.MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Blur"
                                     Storyboard.TargetProperty="Radius"
                                     To="0" Duration="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="Shadow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.8" Duration="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="Zoom"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.15" Duration="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="Zoom"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.15" Duration="0:0:0.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="UIElement.MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Blur"
                                     Storyboard.TargetProperty="Radius"
                                     To="6" Duration="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="Shadow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="Zoom"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.4" />
                    <DoubleAnimation Storyboard.TargetName="Zoom"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <!-- поворот изображения кнопками -->
        <EventTrigger SourceName="LeftButton" RoutedEvent="Button.Click">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Turn"
                                     Storyboard.TargetProperty="Angle"
                                     By="-90" Duration="0:0:0.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger SourceName="RightButton" RoutedEvent="Button.Click">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Turn"
                                     Storyboard.TargetProperty="Angle"
                                     By="90" Duration="0:0:0.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
