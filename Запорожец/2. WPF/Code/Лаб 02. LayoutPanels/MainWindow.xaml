<Window x:Class="LayoutPanels.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диспетчеры компоновки" Height="330" Width="640">
    <!-- DockPanel: слева список документов, сверху панель кнопок,
         в центре набор блоков в WrapPanel внутри ScrollViewer -->
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Margin="8" Width="130">
            <TextBlock Text="Последние документы" Margin="0,0,0,8" />
            <TextBlock Text="1.txt" Margin="0,4" />
            <TextBlock Text="2.txt" Margin="0,4" />
            <TextBlock Text="3.txt" Margin="0,4" />
            <TextBlock Text="4.txt" Margin="0,4" />
            <TextBlock Text="5.txt" Margin="0,4" />
            <TextBlock Text="6.txt" Margin="0,4" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="4">
            <Button Content="Открыть" Margin="4" Padding="6,2" />
            <Button Content="Сохранить" Margin="4" Padding="6,2" />
            <Button Content="Закрыть" Margin="4" Padding="6,2" />
            <Button Content="Обработать" Margin="4" Padding="6,2" />
            <Button Content="О программе" Margin="4" Padding="6,2" />
        </WrapPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,4">
            <TextBlock Text="1.txt" FontWeight="Bold" Margin="0,0,12,0" />
            <TextBlock Text="2.txt" Margin="0,0,12,0" />
            <TextBlock Text="3.txt" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel Margin="8">
                <Border Background="Yellow" Width="70" Height="70" Margin="8">
                    <TextBlock Text="A" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Border Background="Red" Width="70" Height="70" Margin="8">
                    <TextBlock Text="B" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="White" />
                </Border>
                <Border Background="Green" Width="70" Height="70" Margin="8">
                    <TextBlock Text="C" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="White" />
                </Border>
                <Border Background="Blue" Width="70" Height="70" Margin="8">
                    <TextBlock Text="D" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="White" />
                </Border>
                <Border Background="Gray" Width="70" Height="70" Margin="8">
                    <TextBlock Text="E" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="White" />
                </Border>
                <Border Background="Beige" Width="70" Height="70" Margin="8">
                    <TextBlock Text="F" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
