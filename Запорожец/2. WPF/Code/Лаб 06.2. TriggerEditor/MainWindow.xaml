<Window x:Class="TriggerEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор на триггерах" Height="460" Width="640">
    <Window.Resources>
        <LinearGradientBrush x:Key="FieldBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0" />
            <GradientStop Color="LightSteelBlue" Offset="1" />
        </LinearGradientBrush>

        <!-- внешний вид кнопок: обычный, при наведении и при нажатии -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGreen" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="DarkGreen" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Gray" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- внешний вид текстовых полей зависит от выбора в выпадающем списке -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Height" Value="120" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="Black" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=ViewBox, Path=SelectedIndex}" Value="1">
                    <Setter Property="FontFamily" Value="Times New Roman" />
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="Foreground" Value="DarkBlue" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=ViewBox, Path=SelectedIndex}" Value="2">
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Foreground" Value="DarkGreen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- кнопка «Закрыть» доступна, только когда оба поля пусты -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=Left, Path=Text}" Value="" />
                        <Condition Binding="{Binding ElementName=Right, Path=Text}" Value="" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Открыть" Click="Open_Click" />
            <Button Content="Очистить" Click="Clear_Click" />
            <Button Content="Закрыть" Style="{StaticResource CloseButton}" Click="Close_Click" />
            <TextBlock Text="Внешний вид:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox x:Name="ViewBox" Width="180" SelectedIndex="0" VerticalAlignment="Center">
                <ComboBoxItem Content="Обычный" />
                <ComboBoxItem Content="Крупный синий" />
                <ComboBoxItem Content="Моноширинный зелёный" />
            </ComboBox>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="6" Foreground="Gray" TextWrapping="Wrap"
                   Text="Кнопка «Закрыть» становится доступной, когда оба текстовых поля пусты." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Left" Grid.Column="0" Text="Первый текст" />
            <TextBox x:Name="Right" Grid.Column="1" Text="Второй текст" />
        </Grid>
    </DockPanel>
</Window>
