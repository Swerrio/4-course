<Window x:Class="MultiEditAnimation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiEdit" Height="480" Width="760">
    <!-- Задание 3: окно из двух частей с одинаковыми градиентами,
         активное текстовое поле становится большим -->
    <Window.Resources>
        <LinearGradientBrush x:Key="PartBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="White" Offset="0" />
            <GradientStop Color="LightSteelBlue" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="SmallText" TargetType="TextBox">
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Style.Triggers>
                <!-- Задание 1: плавное изменение размера активного поля -->
                <EventTrigger RoutedEvent="GotFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                             To="180" Duration="0:0:0.4" />
                            <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                             To="18" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="LostFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                             To="60" Duration="0:0:0.4" />
                            <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                             To="11" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BigText" TargetType="TextBox" BasedOn="{StaticResource SmallText}">
            <Setter Property="Height" Value="180" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PartBrush}" Margin="6">
            <StackPanel>
                <TextBlock Text="Часть 1" FontWeight="Bold" Margin="8,6" />
                <TextBox x:Name="Text1" Style="{StaticResource BigText}"
                         Text="Первый текст" />
                <TextBox x:Name="Text2" Style="{StaticResource SmallText}"
                         Text="Второй текст" />
                <TextBox x:Name="Text3" Style="{StaticResource SmallText}"
                         Text="Третий текст" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource PartBrush}" Margin="6">
            <StackPanel>
                <TextBlock Text="Часть 2" FontWeight="Bold" Margin="8,6" />
                <TextBox x:Name="Text4" Style="{StaticResource BigText}"
                         Text="Четвёртый текст" />
                <TextBox x:Name="Text5" Style="{StaticResource SmallText}"
                         Text="Пятый текст" />
                <TextBox x:Name="Text6" Style="{StaticResource SmallText}"
                         Text="Шестой текст" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
