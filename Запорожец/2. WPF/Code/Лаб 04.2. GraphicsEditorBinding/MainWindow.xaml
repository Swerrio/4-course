<Window x:Class="GraphicsEditorBinding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ink="clr-namespace:System.Windows.Ink;assembly=PresentationCore"
        xmlns:ctl="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="Графический редактор на привязках" Height="420" Width="660">
    <!-- Задание 4: обработчики событий заменены привязкой данных -->
    <Window.Resources>
        <x:Array x:Key="Brushes" x:Type="{x:Type ink:DrawingAttributes}">
            <ink:DrawingAttributes Color="Black" Width="3" Height="3" />
            <ink:DrawingAttributes Color="Red" Width="8" Height="8" />
            <ink:DrawingAttributes Color="Green" Width="14" Height="14" />
            <ink:DrawingAttributes Color="Blue" Width="22" Height="22" />
        </x:Array>

        <x:Array x:Key="Modes" x:Type="{x:Type ctl:InkCanvasEditingMode}">
            <x:Static Member="ctl:InkCanvasEditingMode.Ink" />
            <x:Static Member="ctl:InkCanvasEditingMode.Select" />
            <x:Static Member="ctl:InkCanvasEditingMode.EraseByStroke" />
        </x:Array>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="200" Margin="8">
            <TextBlock Text="Кисть (цвет и размер)" Margin="0,0,0,4" />
            <ListBox x:Name="BrushList" ItemsSource="{StaticResource Brushes}"
                     SelectedIndex="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="{Binding Path=Width}"
                                     Height="{Binding Path=Height}"
                                     VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding Path=Color}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding Path=Color}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Режим работы" Margin="0,16,0,4" />
            <ListBox x:Name="ModeList" ItemsSource="{StaticResource Modes}"
                     SelectedIndex="0" />

            <TextBlock Text="Текущий режим:" Margin="0,16,0,0" />
            <TextBlock Text="{Binding ElementName=ModeList, Path=SelectedValue}"
                       FontWeight="Bold" />
        </StackPanel>

        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,8,8,8">
            <InkCanvas Background="White"
                       DefaultDrawingAttributes="{Binding ElementName=BrushList, Path=SelectedValue}"
                       EditingMode="{Binding ElementName=ModeList, Path=SelectedValue}" />
        </Border>
    </DockPanel>
</Window>
