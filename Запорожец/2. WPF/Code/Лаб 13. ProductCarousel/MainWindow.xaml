    </Window.Resources>

    <Canvas>
        <Path Stroke="#40000000" StrokeThickness="1" StrokeDashArray="4 4">
            <Path.Data>
                <PathGeometry Figures="M 400,320 C 566,320 700,262 700,200 C 700,138 566,80 400,80 C 234,80 100,138 100,200 C 100,262 234,320 400,320 Z" />
            </Path.Data>
        </Path>
        <Viewbox Canvas.Left="-60" Canvas.Top="-60" Width="120" Opacity="0"
                 Style="{StaticResource Item0}">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <MatrixTransform />
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Image Source="Images/1.png" />
        </Viewbox>
