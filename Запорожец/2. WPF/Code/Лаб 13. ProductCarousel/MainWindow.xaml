<Window x:Class="ProductCarousel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карусель товаров" Height="520" Width="820">
    <!-- Задание 2: изображения товаров движутся по геометрическому пути,
         меняя масштаб и прозрачность -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE8F0FA" Offset="0" />
            <GradientStop Color="#FFB8CCE4" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="Item0" TargetType="Viewbox">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.0">
                            <MatrixAnimationUsingPath Storyboard.TargetProperty="RenderTransform.Children[0].Matrix"
                                                      Duration="0:0:10" DoesRotateWithTangent="False">
                                <MatrixAnimationUsingPath.PathGeometry>
                                    <PathGeometry Figures="M 400,320 C 566,320 700,262 700,200 C 700,138 566,80 400,80 C 234,80 100,138 100,200 C 100,262 234,320 400,320 Z" />
                                </MatrixAnimationUsingPath.PathGeometry>
                            </MatrixAnimationUsingPath>

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX"
                                                           Duration="0:0:10">
                                <LinearDoubleKeyFrame Value="1.4" KeyTime="0:0:0" />
                                <LinearDoubleKeyFrame Value="0.6" KeyTime="0:0:5" />
                                <LinearDoubleKeyFrame Value="1.4" KeyTime="0:0:10" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.Children[1].ScaleY"
                                                           Duration="0:0:10">
                                <LinearDoubleKeyFrame Value="1.4" KeyTime="0:0:0" />
                                <LinearDoubleKeyFrame Value="0.6" KeyTime="0:0:5" />
                                <LinearDoubleKeyFrame Value="1.4" KeyTime="0:0:10" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                           Duration="0:0:10">
                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0" />
                                <LinearDoubleKeyFrame Value="0.35" KeyTime="0:0:5" />
                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:10" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
