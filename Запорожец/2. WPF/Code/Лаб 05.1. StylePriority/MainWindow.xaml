<Window x:Class="StylePriority.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приоритет стиля и атрибута" Height="300" Width="520">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="DarkBlue" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Задание 1. Обе кнопки используют один и тот же стиль. У второй кнопки цвет фона задан атрибутом элемента." />
        <Button Content="Кнопка со стилем" />
        <Button Content="Кнопка со стилем и атрибутом Background" Background="DarkRed" />
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="Bold"
                   Text="Вывод: значение атрибута элемента имеет больший приоритет, чем значение того же свойства в стиле, поэтому вторая кнопка становится тёмно-красной." />
    </StackPanel>
</Window>
