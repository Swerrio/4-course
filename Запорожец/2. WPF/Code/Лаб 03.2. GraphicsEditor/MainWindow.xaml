<Window x:Class="GraphicsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор" Height="420" Width="640">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="180" Margin="8">
            <TextBlock Text="Цвет кисти" Margin="0,0,0,4" />
            <ComboBox x:Name="ColorBox" SelectedIndex="0"
                      SelectionChanged="ColorBox_SelectionChanged">
                <ComboBoxItem Content="Чёрный" />
                <ComboBoxItem Content="Красный" />
                <ComboBoxItem Content="Зелёный" />
                <ComboBoxItem Content="Синий" />
            </ComboBox>

            <TextBlock Text="Размер кисти" Margin="0,16,0,4" />
            <Slider x:Name="SizeSlider" Minimum="1" Maximum="30" Value="5"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="SizeSlider_ValueChanged" />
            <TextBlock x:Name="SizeText" Text="5" HorizontalAlignment="Center" />

            <TextBlock Text="Режим работы" Margin="0,16,0,4" />
            <RadioButton x:Name="DrawMode" Content="Рисование" IsChecked="True"
                         Margin="0,2" Checked="Mode_Checked" />
            <RadioButton x:Name="SelectMode" Content="Редактирование"
                         Margin="0,2" Checked="Mode_Checked" />
            <RadioButton x:Name="EraseMode" Content="Удаление"
                         Margin="0,2" Checked="Mode_Checked" />
        </StackPanel>

        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,8,8,8">
            <InkCanvas x:Name="InkArea" Background="White" />
        </Border>
    </DockPanel>
</Window>
