<Window x:Class="TriggerPriority.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приоритет триггеров" Height="300" Width="560">
    <Window.Resources>
        <Style x:Key="TwoTriggers" TargetType="Button">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <!-- оба триггера меняют одно и то же свойство Background -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGreen" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="Orange" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Задание 1. Наведите курсор на кнопку, затем щёлкните по ней и снова наведите курсор: срабатывают сразу два триггера, которые задают разный цвет фона." />
        <Button Content="Наведите курсор и щёлкните" Style="{StaticResource TwoTriggers}" />
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="Bold"
                   Text="Вывод: если несколько триггеров задают одно свойство, применяется тот, который записан в коллекции Style.Triggers последним — здесь это триггер IsFocused." />
    </StackPanel>
</Window>
