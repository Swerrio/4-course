<Window x:Class="RoadSigns.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дорожные знаки" Height="620" Width="760" Background="White">
    <!-- Первый столбец — знаки, нарисованные объектами Path,
         второй столбец — те же знаки в формате PNG.
         При нажатии знак увеличивается, смещается вправо и возвращается,
         а также открывается исходный SVG-файл. -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Главная дорога -->
        <Viewbox Grid.Row="0" Grid.Column="0" Width="150" Height="150" Margin="10"
                 Tag="main-road" MouseLeftButtonDown="Sign_Click"
                 RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScalePath0" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="MovePath0" X="0" Y="0" />
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Grid Width="300" Height="300" Background="Transparent">
            <Path x:Name="SignPath0" Data="M 150,20 L 280,150 L 150,280 L 20,150 Z" Stroke="White"
                  StrokeThickness="16" Stretch="Uniform" Margin="6">
                <Path.Fill>
                    <SolidColorBrush x:Name="PathFill0" Color="#FFFFCC00" />
                </Path.Fill>
            </Path>
            
            </Grid>
            <Viewbox.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="PathFill0"
                                            Storyboard.TargetProperty="Color"
                                            To="#FF00A0E0" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScalePath0"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="2" Duration="0:0:0.6" AutoReverse="True"
                                             BeginTime="0:0:0" />
                            <DoubleAnimation Storyboard.TargetName="ScalePath0"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="MovePath0"
                                             Storyboard.TargetProperty="X"
                                             To="260" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Viewbox.Triggers>
        </Viewbox>

        <Image Grid.Row="0" Grid.Column="1" Source="Images/main-road.png"
               Width="150" Height="150" Margin="10" Tag="main-road"
               MouseLeftButtonDown="Sign_Click" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleImage0" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="MoveImage0" X="0" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
            <Image.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScaleImage0"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="ScaleImage0"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="MoveImage0"
                                             Storyboard.TargetProperty="X"
                                             To="120" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Главная дорога" Margin="10"
                   VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" />
        <!-- Уступите дорогу -->
        <Viewbox Grid.Row="1" Grid.Column="0" Width="150" Height="150" Margin="10"
                 Tag="give-way" MouseLeftButtonDown="Sign_Click"
                 RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScalePath1" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="MovePath1" X="0" Y="0" />
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Grid Width="300" Height="300" Background="Transparent">
            <Path x:Name="SignPath1" Data="M 20,40 L 280,40 L 150,270 Z" Stroke="#FFD52B1E"
                  StrokeThickness="26" Stretch="Uniform" Margin="6">
                <Path.Fill>
                    <SolidColorBrush x:Name="PathFill1" Color="White" />
                </Path.Fill>
            </Path>
            
            </Grid>
            <Viewbox.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="PathFill1"
                                            Storyboard.TargetProperty="Color"
                                            To="#FF00A0E0" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScalePath1"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="2" Duration="0:0:0.6" AutoReverse="True"
                                             BeginTime="0:0:0" />
                            <DoubleAnimation Storyboard.TargetName="ScalePath1"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="MovePath1"
                                             Storyboard.TargetProperty="X"
                                             To="260" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Viewbox.Triggers>
        </Viewbox>

        <Image Grid.Row="1" Grid.Column="1" Source="Images/give-way.png"
               Width="150" Height="150" Margin="10" Tag="give-way"
               MouseLeftButtonDown="Sign_Click" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleImage1" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="MoveImage1" X="0" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
            <Image.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScaleImage1"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="ScaleImage1"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="MoveImage1"
                                             Storyboard.TargetProperty="X"
                                             To="120" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="Уступите дорогу" Margin="10"
                   VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" />
        <!-- Движение без остановки запрещено -->
        <Viewbox Grid.Row="2" Grid.Column="0" Width="150" Height="150" Margin="10"
                 Tag="stop" MouseLeftButtonDown="Sign_Click"
                 RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScalePath2" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="MovePath2" X="0" Y="0" />
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Grid Width="300" Height="300" Background="Transparent">
            <Path x:Name="SignPath2" Data="M 88,20 L 212,20 L 280,88 L 280,212 L 212,280 L 88,280 L 20,212 L 20,88 Z" Stroke="White"
                  StrokeThickness="12" Stretch="Uniform" Margin="6">
                <Path.Fill>
                    <SolidColorBrush x:Name="PathFill2" Color="#FFD52B1E" />
                </Path.Fill>
            </Path>
            <TextBlock Text="STOP" FontFamily="Arial" FontSize="52" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Viewbox.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="PathFill2"
                                            Storyboard.TargetProperty="Color"
                                            To="#FF00A0E0" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScalePath2"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="2" Duration="0:0:0.6" AutoReverse="True"
                                             BeginTime="0:0:0" />
                            <DoubleAnimation Storyboard.TargetName="ScalePath2"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="MovePath2"
                                             Storyboard.TargetProperty="X"
                                             To="260" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Viewbox.Triggers>
        </Viewbox>

        <Image Grid.Row="2" Grid.Column="1" Source="Images/stop.png"
               Width="150" Height="150" Margin="10" Tag="stop"
               MouseLeftButtonDown="Sign_Click" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleImage2" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="MoveImage2" X="0" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
            <Image.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScaleImage2"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="ScaleImage2"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="2" Duration="0:0:0.6" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="MoveImage2"
                                             Storyboard.TargetProperty="X"
                                             To="120" Duration="0:0:0.6" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>

        <TextBlock Grid.Row="2" Grid.Column="2" Text="Движение без остановки запрещено" Margin="10"
                   VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" />
    </Grid>
</Window>
